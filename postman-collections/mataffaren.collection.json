		{
			"name": "Get productlist within category/Sort",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// Unpack from JSON all the categories",
							"let categories = pm.variables.get('categoryData');",
							"",
							"",
							"// Get the category counter and convert to number (using +)",
							"let categoryCounter = pm.variables.get('categoryCounter');",
							"",
							"// Get the category part of the url and set it as an environment variable",
							"let urlCategoryPart = categories.children[categoryCounter].url;",
							"pm.environment.set('urlCategoryPart',urlCategoryPart);",
							"",
							"// Add 1 to the categoryCounter environment variable",
							"pm.variables.set('categoryCounter', categoryCounter + 1);"
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Unpack from JSON all the categories",
							"let categories = pm.variables.get('categoryData');",
							"",
							"if (typeof categories === 'string') {",
							"    categories = JSON.parse(categories);  // Ensure categories is parsed as an object",
							"}",
							"",
							"// Get the category counter and convert to number (using +)",
							"let categoryCounter = pm.variables.get('categoryCounter');",
							"",
							"// Tests",
							"",
							"// Check that the status code is 200 (OK)",
							"pm.test('The status code of the response should be 200', () => {",
							"  pm.response.to.have.status(200);",
							"});",
							"",
							"// Check that we have a response time of < 1 second",
							"pm.test('The response time should be below 1 second', () => {",
							"    pm.expect(pm.response.responseTime).to.be.below(1000);",
							"});",
							"",
							"// Check that we have at least one product in the this main category",
							"let responseData = pm.response.json();",
							"pm.test('There should be at least one product in a main category', () => {",
							"    pm.expect(responseData.results.length).to.be.at.least(1);",
							"});",
							"",
							"//Get product list within category sort=topRated",
							"",
							"//Save the products in this category for future tests",
							"let urlCategoryPart = pm.environment.get('urlCategoryPart')",
							"let PBC = pm.variables.get('productsByCategory');",
							"PBC[urlCategoryPart] = {topRated: responseData.results};",
							"PBC[urlCategoryPart].aZ = responseData.results.toSorted((a,b)=>a.name>b.name ? 1:-1);",
							"PBC[urlCategoryPart].zA = PBC[urlCategoryPart].aZ.toReversed();",
							"pm.variables.set('productsByCategory', PBC);",
							"// TODO: ADD SORTING BY price and jamförelsePris",
							"",
							"",
							"",
							"pm.test(\"Products should be sorted by top rating\", () => {",
							"    let products = responseData.results;",
							"    let sorted = true;",
							"    for (let i = 1; i < products.length; i++) {",
							"        if (products[i].rating > products[i - 1].rating) {",
							"            sorted = false;",
							"            break;",
							"        }",
							"    }",
							"    pm.expect(sorted).to.be.true;",
							"});",
							"",
							"/*pm.test(\"Products sorted A-Z\", () => {",
							"    let aZ = PBC[urlCategoryPart].aZ;",
							"    pm.expect(aZ).to.eql(responseData.results.toSorted((a,b)=>a.name>b.name ? 1:-1));",
							"});",
							"",
							"pm.test(\"Products sorted Z-A\", () => {",
							"    let zA = PBC[urlCategoryPart].zA;",
							"    pm.expect(zA).to.eql(PBC[urlCategoryPart].aZ.toReversed());",
							"});*/",
							"",
							"",
							"// Repeat/loop this request until we have requested all main categories",
							"if(categories.children[categoryCounter]){",
							"  // Repeat this request (with new variable data for the url)",
							"  pm.execution.setNextRequest('Get productlist within category/Sort');",
							"}else",
							" {",
							"    console.log('No more categories to process.');",
							"    pm.variables.set('categoryCounter', 0); ",
							"    pm.execution.setNextRequest('Get productlist within subCategory')",
							"    }",
							"",
							"    "
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
